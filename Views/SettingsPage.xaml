<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NewColoringbook.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NewColoringbook"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppChromeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource AppChromeBrush}"
            BorderBrush="{ThemeResource AppLineBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,8,18,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="40" Height="40"
                    AutomationProperties.Name="Back"
                    ToolTipService.ToolTip="Back">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE72B;" />
                </Button>
                <TextBlock Text="Settings &amp; about" Style="{StaticResource TitleText}" FontSize="20" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="18,14,18,18">
            <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardRoot}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionText}" />
                        <TextBlock Text="Choose the studio theme. Artwork pages stay a bright paper white for easy coloring."
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <RadioButtons x:Name="ThemeRadio" SelectionChanged="ThemeRadio_SelectionChanged" MaxColumns="3">
                            <RadioButton Content="Light" Tag="Light" />
                            <RadioButton Content="Dark" Tag="Dark" />
                            <RadioButton Content="Follow system" Tag="System" />
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardRoot}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Ambient music" Style="{StaticResource SectionText}" />
                        <TextBlock Text="Choose from 8 relaxing ambient tracks to accompany your coloring sessions."
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <ComboBox x:Name="MusicTrackCombo" Header="Ambient track"
                                  Width="280" HorizontalAlignment="Left"
                                  SelectionChanged="MusicTrackCombo_SelectionChanged"
                                  AutomationProperties.Name="Ambient music track" />
                        <ToggleSwitch x:Name="MusicToggle" Header="Play ambient music"
                                      Toggled="MusicToggle_Toggled"
                                      OnContent="Playing" OffContent="Paused" />
                        <Slider x:Name="VolumeSlider" Header="Volume" Minimum="0" Maximum="1" StepFrequency="0.01"
                                ValueChanged="VolumeSlider_ValueChanged" Width="280" HorizontalAlignment="Left"
                                AutomationProperties.Name="Music volume" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardRoot}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Your data" Style="{StaticResource SectionText}" />
                        <TextBlock Text="All coloring progress, palettes and settings are stored only on this device, in the app's local folder. Nothing is sent anywhere."
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ExportDataButton" Content="Export all data" Click="ExportDataButton_Click" CornerRadius="10" />
                            <Button x:Name="ImportDataButton" Content="Import data" Click="ImportDataButton_Click" CornerRadius="10" />
                            <Button x:Name="ResetDataButton" Content="Reset all progress" Click="ResetDataButton_Click" CornerRadius="10" />
                        </StackPanel>
                        <TextBlock x:Name="DataStatusText" Text="" Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardRoot}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Help &amp; shortcuts" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Text="Tap any enclosed area to fill it with the active color and texture. Drag to pan, use the mouse wheel to zoom, and switch tools on the right rail. Everything is saved automatically." />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Text="Shortcuts: F fill · B brush · E eraser · Ctrl+Z undo · Ctrl+Y redo · + / - zoom · 0 fit view" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Text="Privacy: Stress Relief Coloring Book works fully offline. No account, no telemetry, no network access." />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Stress Relief Coloring Book 1.0 · Original artwork generated in-app" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

