<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NewColoringbook.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NewColoringbook"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppChromeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top app bar  -->
        <Border
            Grid.Row="0"
            Padding="18,10,18,10"
            Background="{ThemeResource AppChromeBrush}"
            BorderBrush="{ThemeResource AppLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="MenuButton"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="Open navigation menu"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MenuButton_Click"
                    ToolTipService.ToolTip="Menu">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE700;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Click="MenuHome_Click" Text="Home">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE80F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="FreeDrawButton_Click" Text="Free Draw">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="MenuArtwork_Click" Text="My Artwork">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE790;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="MenuSettings_Click" Text="Settings &amp; about">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <TextBlock
                    x:Name="AppTitleText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleText}"
                    Text="Stress Relief Coloring Book" />
                <Button
                    x:Name="FreeDrawButton"
                    Grid.Column="3"
                    AutomationProperties.Name="Start a free draw blank canvas"
                    Click="FreeDrawButton_Click"
                    Style="{StaticResource PrimaryActionButton}"
                    ToolTipService.ToolTip="Start a blank canvas to draw freely">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                            FontSize="14"
                            Glyph="&#xE70F;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Free Draw" />
                    </StackPanel>
                </Button>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="4"
                    Width="240"
                    AutomationProperties.Name="Search designs"
                    PlaceholderText="Search designs..."
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged" />
                <Button
                    x:Name="SettingsButton"
                    Grid.Column="5"
                    Height="40"
                    AutomationProperties.Name="Settings and about"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings &amp; about">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE713;" />
                </Button>
            </Grid>
        </Border>

        <!--  Category chips  -->
        <Border
            Grid.Row="1"
            Padding="18,6,18,6"
            Background="{ThemeResource AppChromeBrush}"
            BorderBrush="{ThemeResource AppLineBrush}"
            BorderThickness="0,0,0,1">
            <ScrollViewer
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Auto"
                VerticalScrollMode="Disabled">
                <StackPanel
                    x:Name="CategoryPanel"
                    Orientation="Horizontal"
                    Spacing="8" />
            </ScrollViewer>
        </Border>

        <ScrollViewer
            x:Name="MainScrollViewer"
            Grid.Row="2"
            Padding="18,14,18,18">
            <StackPanel
                MaxWidth="1400"
                HorizontalAlignment="Left"
                Spacing="18">
                <StackPanel x:Name="ContinueSection" Spacing="10">
                    <TextBlock
                        x:Name="ContinueHeaderText"
                        Style="{StaticResource SectionText}"
                        Text="Continue coloring" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Auto"
                        VerticalScrollMode="Disabled">
                        <StackPanel
                            x:Name="ContinueList"
                            Orientation="Horizontal"
                            Spacing="14" />
                    </ScrollViewer>
                </StackPanel>


                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ComboBox
                                x:Name="ComplexityCombo"
                                MinWidth="165"
                                AutomationProperties.Name="Filter by complexity"
                                SelectionChanged="ComplexityCombo_SelectionChanged"
                                ToolTipService.ToolTip="Filter by complexity rate">
                                <ComboBoxItem
                                    Content="All Complexity"
                                    IsSelected="True"
                                    Tag="all" />
                                <ComboBoxItem Content="★☆☆☆☆ Simple" Tag="1" />
                                <ComboBoxItem Content="★★☆☆☆ Easy" Tag="2" />
                                <ComboBoxItem Content="★★★☆☆ Medium" Tag="3" />
                                <ComboBoxItem Content="★★★★☆ Complex" Tag="4" />
                                <ComboBoxItem Content="★★★★★ Zentangle" Tag="5" />
                            </ComboBox>
                            <ComboBox
                                x:Name="SortCombo"
                                MinWidth="135"
                                AutomationProperties.Name="Sort designs"
                                SelectionChanged="SortCombo_SelectionChanged"
                                ToolTipService.ToolTip="Sort designs">
                                <ComboBoxItem Content="Popular" Tag="popular" />
                                <ComboBoxItem Content="A to Z" Tag="az" />
                                <ComboBoxItem Content="Progress" Tag="progress" />
                                <ComboBoxItem Content="Complexity (Low-High)" Tag="complex_asc" />
                                <ComboBoxItem Content="Complexity (High-Low)" Tag="complex_desc" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        x:Name="EmptyResultsText"
                        Style="{StaticResource BodyText}"
                        Text="No designs match your search."
                        Visibility="Collapsed" />
                    <ItemsControl x:Name="DesignGrid" Grid.Row="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemHeight="312"
                                    ItemWidth="236"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

