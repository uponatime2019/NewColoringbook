<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NewColoringbook.Views.StudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NewColoringbook"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="Page_KeyDown"
    KeyUp="Page_KeyUp"
    Background="{ThemeResource AppChromeBrush}">

    <Page.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppLineBrush}" />
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ToolPlainButton" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppLineBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="UndoAccelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Invoked="ToolAccelerator_Invoked" />
        <KeyboardAccelerator Key="B" Invoked="ToolAccelerator_Invoked" />
        <KeyboardAccelerator Key="E" Invoked="ToolAccelerator_Invoked" />
        <KeyboardAccelerator Key="Add" Invoked="ZoomAccelerator_Invoked" />
        <KeyboardAccelerator Key="Subtract" Invoked="ZoomAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number0" Invoked="ZoomAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Studio header -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource AppChromeBrush}"
            BorderBrush="{ThemeResource AppLineBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,8,18,8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="40" Height="40"
                    AutomationProperties.Name="Back to gallery"
                    ToolTipService.ToolTip="Back to gallery (Esc)">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE72B;" />
                </Button>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="1"
                    Text="Artwork"
                    Style="{StaticResource TitleText}"
                    FontSize="20"
                    VerticalAlignment="Center" />
                <Border
                    Grid.Column="2"
                    Background="{ThemeResource AppAccentSoftBrush}"
                    CornerRadius="10"
                    Padding="10,3,10,3"
                    VerticalAlignment="Center">
                    <TextBlock x:Name="PercentText" Text="0%" FontSize="13" Foreground="{ThemeResource AppAccentInkBrush}" />
                </Border>
                <Button x:Name="UndoButton" Grid.Column="4" Click="UndoButton_Click" Style="{StaticResource HeaderButton}"
                        AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE7A7;" />
                </Button>
                <Button x:Name="RedoButton" Grid.Column="5" Click="RedoButton_Click" Style="{StaticResource HeaderButton}"
                        AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE7A6;" />
                </Button>
                <Button x:Name="SaveButton" Grid.Column="6" Click="SaveButton_Click" Style="{StaticResource HeaderButton}"
                        AutomationProperties.Name="Save artwork" ToolTipService.ToolTip="Save now">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74E;" />
                </Button>
                <Button x:Name="ExportButton" Grid.Column="7" Click="ExportButton_Click" Style="{StaticResource HeaderButton}"
                        AutomationProperties.Name="Export as PNG" ToolTipService.ToolTip="Export PNG">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE896;" />
                </Button>
                <Button x:Name="PrintButton" Grid.Column="8" Click="PrintButton_Click" Style="{StaticResource HeaderButton}"
                        AutomationProperties.Name="Print artwork" ToolTipService.ToolTip="Print">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE749;" />
                </Button>
                <Button x:Name="ShareButton" Grid.Column="9" Click="ShareButton_Click" Style="{StaticResource HeaderButton}"
                        AutomationProperties.Name="Share artwork" ToolTipService.ToolTip="Share">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE72D;" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Palette panel -->
            <Border
                Grid.Column="0"
                Width="240"
                Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource AppLineBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,12,12,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Color" Style="{StaticResource SectionText}" FontSize="15" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ActiveSwatch" Width="44" Height="44" CornerRadius="10" BorderBrush="{ThemeResource AppLineBrush}" BorderThickness="1" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ActiveHexText" Text="#F4845F" Style="{StaticResource BodyText}" FontSize="12" />
                                <TextBlock x:Name="ActiveTextureText" Text="Solid" Style="{StaticResource BodyText}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                        <ComboBox x:Name="PaletteCombo" SelectionChanged="PaletteCombo_SelectionChanged" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Palette selection" />
                        <Grid x:Name="SwatchGrid" />
                        <Button x:Name="MixButton" Click="MixButton_Click" HorizontalAlignment="Stretch" CornerRadius="10"
                                Content="Mix a new color..." AutomationProperties.Name="Open color mixer"
                                ToolTipService.ToolTip="Open the color mixer and texture picker" />
                        <TextBlock Text="Recent" Style="{StaticResource SectionText}" FontSize="13" Margin="0,6,0,0" />
                        <Grid x:Name="RecentGrid" />
                        <TextBlock Text="My swatches" Style="{StaticResource SectionText}" FontSize="13" Margin="0,6,0,0" />
                        <Grid x:Name="CustomGrid" />
                        <TextBlock x:Name="CustomEmptyText" Text="Save mixed colors here from the mixer." Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="Brush size" Style="{StaticResource SectionText}" FontSize="13" Margin="0,10,0,0" />
                        <Slider x:Name="BrushSizeSlider" Minimum="6" Maximum="60" StepFrequency="1" ValueChanged="BrushSizeSlider_ValueChanged"
                                AutomationProperties.Name="Brush size" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Canvas -->
            <Grid x:Name="CanvasHost" Grid.Column="1" Background="{ThemeResource AppPaperBrush}"
                  SizeChanged="CanvasHost_SizeChanged"
                  PointerPressed="CanvasHost_PointerPressed"
                  PointerMoved="CanvasHost_PointerMoved"
                  PointerReleased="CanvasHost_PointerReleased"
                  PointerWheelChanged="CanvasHost_PointerWheelChanged"
                  PointerCaptureLost="CanvasHost_PointerCaptureLost">
                <Canvas x:Name="ArtRoot" Width="1000" Height="1000" IsHitTestVisible="True">
                    <Canvas.RenderTransform>
                        <MatrixTransform x:Name="ViewTransform" />
                    </Canvas.RenderTransform>
                    <Canvas x:Name="RegionLayer" Width="1000" Height="1000" />
                    <Canvas x:Name="StrokeLayer" Width="1000" Height="1000" IsHitTestVisible="False" />
                </Canvas>
                <Border
                    x:Name="ZoomOverlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,14"
                    Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource AppLineBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="4,2,4,2"
                    Opacity="0.94">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="ZoomOutButton" Click="ZoomOutButton_Click" Style="{StaticResource MiniButton}"
                                AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE949;" FontSize="12" />
                        </Button>
                        <Button x:Name="FitButton" Click="FitButton_Click" Style="{StaticResource MiniButton}" Content="Fit"
                                AutomationProperties.Name="Fit artwork to view" ToolTipService.ToolTip="Fit to view (0)" FontSize="12" />
                        <TextBlock x:Name="ZoomPercentText" Text="100%" VerticalAlignment="Center" FontSize="12" Width="44" TextAlignment="Center"
                                   Foreground="{ThemeResource AppSubtleBrush}" />
                        <Button x:Name="ZoomInButton" Click="ZoomInButton_Click" Style="{StaticResource MiniButton}"
                                AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE948;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tool rail -->
            <Border
                Grid.Column="2"
                Width="76"
                Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource AppLineBrush}"
                BorderThickness="1,0,0,0"
                Padding="0,12,0,12">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <ToggleButton x:Name="FillToolButton" Style="{StaticResource ToolButton}" Click="FillTool_Click"
                                  AutomationProperties.Name="Fill tool" ToolTipService.ToolTip="Fill (F)">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE790;" />
                            <TextBlock Text="Fill" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BrushToolButton" Style="{StaticResource ToolButton}" Click="BrushTool_Click"
                                  AutomationProperties.Name="Brush tool" ToolTipService.ToolTip="Brush (B)">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE70F;" />
                            <TextBlock Text="Brush" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="TextureButton" Style="{StaticResource ToolPlainButton}" Click="TextureButton_Click"
                            AutomationProperties.Name="Choose texture" ToolTipService.ToolTip="Texture">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8CB;" />
                            <TextBlock x:Name="TextureButtonText" Text="Solid" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="TextureFlyout" Placement="Left">
                                <StackPanel x:Name="TextureFlyoutPanel" Spacing="8" MinWidth="180" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ToggleButton x:Name="EraserToolButton" Style="{StaticResource ToolButton}" Click="EraserTool_Click"
                                  AutomationProperties.Name="Eraser tool" ToolTipService.ToolTip="Eraser (E)">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE75C;" />
                            <TextBlock Text="Eraser" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Rectangle Height="1" Width="44" Fill="{ThemeResource AppLineBrush}" Margin="0,4,0,4" />
                    <Button x:Name="ResetButton" Style="{StaticResource ToolPlainButton}" Click="ResetButton_Click"
                            AutomationProperties.Name="Reset artwork" ToolTipService.ToolTip="Reset artwork">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE72C;" />
                            <TextBlock Text="Reset" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

